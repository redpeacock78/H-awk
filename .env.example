# H-awk server config
HAWK_PORT=8080
HAWK_MAX_HEADER_SIZE=8192
HAWK_MAX_BODY_SIZE=1048576
HAWK_REQUEST_TIMEOUT=30

# Set DEV=1 for verbose logging and stack traces in error bodies
DEV=0

# Plugin config (uncomment as plugins are installed)
# CSRF_SECRET=change-me-in-production
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=hawk-assets
# PG_DSN=host=db user=app dbname=hawk
