#!/usr/bin/env bash
set -e

export HAWK_LIB="${HAWK_LIB:-$(cd "$(dirname "$0")/.." && pwd)}"
HAWK_LIBEXEC="${HAWK_LIBEXEC:-$(cd "$(dirname "$0")" && pwd)}"
LIBS="${HAWK_LIBEXEC}/hawk-libs"

STRICT=0
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --strict) STRICT=1; shift ;;
    *)        args+=("$1"); shift ;;
  esac
done

APP="${args[0]:-app.awk}"
if [[ ! -f "$APP" ]]; then
  echo "[hawk] app file not found: $APP" >&2
  exit 1
fi

if [[ -f .env ]]; then
  set -a
  # shellcheck source=/dev/null
  . ./.env
  set +a
fi

# check は検証のみが目的。永続 dist に publish した後で strict 検証が走ると、
# 検証失敗でも成果物が更新済みになり、稼働中の hawk-serve が失敗した check の
# 出力を読んでしまう。呼び出し元の HAWK_DIST も使わず隔離した一時 dist に出す
HAWK_DIST="$(mktemp -d /tmp/hawk-check.XXXXXX)"
export HAWK_DIST
trap 'rm -rf "$HAWK_DIST"' EXIT

APP_AWK="$("$LIBS" desugar "$APP")"

if [[ "$STRICT" -eq 1 ]]; then
  if ! gawk --sandbox -f "${HAWK_LIB}/dsl/adt.awk" -f "${HAWK_LIB}/dsl/type.awk" -f "${HAWK_LIB}/dsl/strict_stubs.awk" -f "$APP_AWK" < /dev/null >/dev/null 2>&1; then
    echo "[hawk] --strict: gawk syntax error in desugared output" >&2
    exit 1
  fi
fi

exit 0
