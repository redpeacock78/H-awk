#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# H-awk entry: .env load → plugin glob → libs glob → multi-worker supervisor loop

# Require bash 4.3+ for wait -n
if [[ "${BASH_VERSINFO[0]}" -lt 4 || ( "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -lt 3 ) ]]; then
  echo "[hawk] bash 4.3+ required (got ${BASH_VERSION})" >&2
  exit 1
fi

set -e

# Parse --workers / -w before APP argument
WORKERS="${HAWK_WORKERS:-4}"
NO_EMIT=0
EMIT=0
STRICT=0
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --workers|-w)
      WORKERS="$2"
      shift 2
      ;;
    --workers=*)
      WORKERS="${1#*=}"
      shift
      ;;
    --debug)
      HAWK_DEBUG=1
      shift
      ;;
    --no-emit)
      NO_EMIT=1
      shift
      ;;
    --emit)
      EMIT=1
      shift
      ;;
    --strict)
      STRICT=1
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

APP="${args[0]:-app.awk}"
if [[ ! -f "$APP" ]]; then
  echo "[hawk] app file not found: $APP" >&2
  exit 1
fi

if [[ "$NO_EMIT" -eq 1 && "$EMIT" -eq 1 ]]; then
  echo "[hawk] --no-emit and --emit are mutually exclusive" >&2
  exit 1
fi

# .env を export (値内スペース安全)
if [[ -f .env ]]; then
  set -a
  # shellcheck source=/dev/null
  . ./.env
  set +a
fi

# Collect plugin files: plugins/<name>/{manifest.awk,<name>.awk}
# .disabled マーカーがあるディレクトリはスキップ
PLUGIN_FILES=""
for d in plugins/*/; do
  [[ -d "$d" ]] || continue
  [[ -f "${d}.disabled" ]] && continue
  name=$(basename "$d")
  manifest="${d}manifest.awk"
  impl="${d}${name}.awk"
  [[ -f "$manifest" ]] && PLUGIN_FILES="$PLUGIN_FILES -f $manifest"
  [[ -f "$impl" ]]     && PLUGIN_FILES="$PLUGIN_FILES -f $impl"
done

# Libs glob (v0.2): libs/<name>/zig-out/lib/libhawk_<name>.{so,dylib} を検出
LIBS_ARGS=""
LIBS_VARS=""
case "$(uname -s)" in
  Darwin) SO_EXT=dylib ;;
  *)      SO_EXT=so ;;
esac

if [[ -z "$HAWK_NO_LIBS" ]]; then
  for d in libs/*/; do
    [[ -d "$d" ]] || continue
    name=$(basename "$d")
    [[ "$name" = "_common" ]] && continue
    so="${d}zig-out/lib/libhawk_${name}.${SO_EXT}"
    if [[ -f "$so" ]]; then
      LIBS_ARGS="$LIBS_ARGS -l $so"
      LIBS_VARS="$LIBS_VARS -v HAWK_LIBS_${name}=1"
    else
      if [[ -f "${d}build.zig" ]]; then
        echo "[WARN] libs/${name} 未ビルド ($so 不在)。機能 fallback 動作" >&2
      fi
    fi
  done
  export AWKLIBPATH
fi

# libs/net が利用可能な場合のみ multi-worker 有効 (SO_REUSEPORT 必須)
if echo "$LIBS_ARGS" | grep -q "libhawk_net"; then
  EFFECTIVE_WORKERS="$WORKERS"
else
  if [[ "$WORKERS" -gt 1 ]]; then
    echo "[hawk] [WARN] libs/net not available, multi-worker disabled (falling back to 1 worker)" >&2
  fi
  EFFECTIVE_WORKERS=1
fi

# PID ファイルで前回の stale プロセスを終了させる
HAWK_PIDFILE="${TMPDIR:-/tmp}/hawk-$(pwd | tr '/' '_').pid"
if [[ -f "$HAWK_PIDFILE" ]]; then
  old_pid=$(cat "$HAWK_PIDFILE" 2>/dev/null)
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    kill -TERM "$old_pid" 2>/dev/null || true
    sleep 0.3
  fi
  rm -f "$HAWK_PIDFILE"
fi

WORKER_PIDS=()

shutdown() {
  for pid in "${WORKER_PIDS[@]}"; do
    kill -TERM "$pid" 2>/dev/null || true
  done
  for pid in "${WORKER_PIDS[@]}"; do
    wait "$pid" 2>/dev/null || true
  done
  rm -f "$HAWK_PIDFILE"
  exit 0
}
trap shutdown INT TERM

# Resolve HAWK_LIB: directory containing hawk.awk (default: script's parent)
HAWK_LIB="${HAWK_LIB:-$(cd "$(dirname "$0")/.." && pwd)}"

_hawk_desugar_app() {
  local src="$1"
  local tmp
  tmp=$(mktemp /tmp/hawk.XXXXXX.awk)
  if [[ -n "${HAWK_DEBUG}" ]]; then
    echo "[hawk] desugar tmp: $tmp" >&2
  fi
  gawk -f "${HAWK_LIB}/dsl/desugar.awk" "$src" > "$tmp"
  if [[ $? -ne 0 || ! -s "$tmp" ]]; then
    echo "[hawk] desugar failed: $src" >&2
    rm -f "$tmp"
    exit 1
  fi
  echo "$tmp"
}

APP_AWK=$(_hawk_desugar_app "$APP")
# shellcheck disable=SC2064
[[ -z "${HAWK_DEBUG}" ]] && trap "rm -f '$APP_AWK'" EXIT

# --emit: print desugared AWK to stdout, exit
if [[ "$EMIT" -eq 1 ]]; then
  if [[ "$STRICT" -eq 1 ]]; then
    gawk --sandbox -f "$APP_AWK" < /dev/null 2>/dev/null || {
      echo "[hawk] --strict: gawk syntax error in desugared output" >&2
      exit 1
    }
  fi
  cat "$APP_AWK"
  exit 0
fi

# --no-emit: type-check only, exit without starting server
if [[ "$NO_EMIT" -eq 1 ]]; then
  if [[ "$STRICT" -eq 1 ]]; then
    gawk --sandbox -f "$APP_AWK" < /dev/null 2>/dev/null || {
      echo "[hawk] --strict: gawk syntax error in desugared output" >&2
      exit 1
    }
  fi
  exit 0
fi

# Start N workers
for (( i=0; i<EFFECTIVE_WORKERS; i++ )); do
  # shellcheck disable=SC2086
  gawk -b $LIBS_ARGS $LIBS_VARS -f hawk.awk $PLUGIN_FILES -f "$APP_AWK" &
  WORKER_PIDS+=($!)
done

echo "$$" > "$HAWK_PIDFILE"

# Supervisor loop: wait -n (bash 4.3+) blocks until any child exits.
# Then kill -0 scan identifies which worker died → restart if non-zero exit.
while [[ ${#WORKER_PIDS[@]} -gt 0 ]]; do
  wait -n 2>/dev/null || true

  new_pids=()
  for pid in "${WORKER_PIDS[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      new_pids+=("$pid")
    else
      wait "$pid" 2>/dev/null
      status=$?
      if [[ "$status" -eq 0 ]]; then
        : # clean exit; don't restart
      else
        echo "[hawk] worker $pid exited $status, restart in 1s" >&2
        sleep 1
        # shellcheck disable=SC2086
        gawk -b $LIBS_ARGS $LIBS_VARS -f hawk.awk $PLUGIN_FILES -f "$APP_AWK" &
        new_pids+=($!)
      fi
    fi
  done
  WORKER_PIDS=("${new_pids[@]}")
done
